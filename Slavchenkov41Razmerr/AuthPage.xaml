<Page x:Class="Slavchenkov41Razmerr.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Slavchenkov41Razmerr"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0" FontSize="20"></TextBlock>
        <TextBlock Text="Пароль" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1" FontSize="20"></TextBlock>

        <TextBox Name="Login" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Grid.Row="0" Width="200" Height="30"></TextBox>
        <TextBox Name="Password" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" Width="200" Height="30"></TextBox>

        <StackPanel Name="CaptchaInputPanel" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Введите капчу:" HorizontalAlignment="Right" Margin="0,0,0,5"></TextBlock>
            <TextBox Name="CaptchaInput" Width="200" Height="40"></TextBox>
        </StackPanel>

        <StackPanel Name="CaptchaPanel" Orientation="Horizontal" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
            <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0"></TextBlock>
            <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,5,0,0"></TextBlock>
            <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough"></TextBlock>
            <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,10,0,0"></TextBlock>
        </StackPanel>

        <Button Content="Войти как гость" Grid.Column="0" Grid.Row="3" Name="GuestBtn" Click="GuestBtn_Click"></Button>
        <Button Content="Войти" Grid.Column="1" Grid.Row="3" Name="LoginBtn" Click="LoginBtn_Click"></Button>
    </Grid>
</Page>